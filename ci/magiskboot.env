# Pinned Magisk toolchain for the reproducible boot-image CI workflow.
#
# magiskboot is taken from the OFFICIAL topjohnwu/Magisk release APK
# (asset: lib/x86_64/libmagiskboot.so, a standalone ELF shared object that
# runs directly on Linux x86_64). The APK itself is SHA-256 verified against
# this file before anything is extracted, so no unofficial mirror binary is
# ever executed.
MAGISK_VERSION=v30.1
MAGISK_COMMIT=78f7fa348eec53bbe154afb3026e75595b6d662e
MAGISK_APK_URL=https://github.com/topjohnwu/Magisk/releases/download/v30.1/Magisk-v30.1.apk
MAGISK_APK_SHA256=248735479ba807c879aea69494896b5ba581a006735142b09d353961d66d7d2a
MAGISKBOOT_ENTRY=lib/x86_64/libmagiskboot.so
MAGISKBOOT_SHA256=4a593dfdd1b08fa8a217efce8775c62a567076059a8098727f59a11496d7dbe6
